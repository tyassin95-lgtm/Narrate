<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml: the sealed API keys cannot be read on any other device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="narrate_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="narrate_secure.xml" />
    </device-transfer>
</data-extraction-rules>
